# =============================================
# SISTEM MANAJEMEN KELUHAN PELANGGAN - ENV
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/keluhan-pelanggan

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars_change_in_production
JWT_EXPIRES_IN=7d

# Email (SMTP) — Leave blank to use console logging in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@keluhanpelanggan.com

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
